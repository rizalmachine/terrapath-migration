# TerraPath migration configuration (copy to .env). All optional -- sensible defaults work with zero setup.

# DuckDB file paths (relative to project root)
# TERRAPATH_SOURCE_DB_PATH=data/source.duckdb
# TERRAPATH_WAREHOUSE_DB_PATH=data/warehouse.duckdb

# Synthetic data generation
# TERRAPATH_SEED=42
# TERRAPATH_FARMERS=2000

# Redshift DDL generator placeholders (never used to connect to anything -- output is text only)
# TERRAPATH_S3_BUCKET=terrapath-demo-bucket
# TERRAPATH_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/terrapath-redshift-copy-role
